+# J324: configure inert peers without replacing the one active traffic peer.
+# Each scale has one established peer; the remainder are configured, unhandshaken peers.
+scale_previous=1
+for scale_count in 1 100 1000; do
+    scale_add=$((scale_count - scale_previous))
+    if ((scale_add)); then
+        for side in a b; do
+            if [[ $SYSTEM == kernel-plain ]]; then
+                python3 -I "$H2H_KIT/lib/peer_scale.py" kernel-config \
+                    --count "$scale_add" --start "$scale_previous" --output "$D/$scale_count-$side.conf"
+                ip netns exec "h2h-$side" "$H2H_BIN/wg" addconf "wg${side^^}" "$D/$scale_count-$side.conf"
+            else
+                if [[ $SYSTEM == gotatun ]]; then
+                    peer_pid=$GOTA_A_PID; [[ $side == b ]] && peer_pid=$GOTA_B_PID
+                else
+                    peer_pid=$WG_A_PID; [[ $side == b ]] && peer_pid=$WG_B_PID
+                fi
+                nsenter -t "$peer_pid" -n -m -- python3 -I "$H2H_KIT/lib/peer_scale.py" add-uapi \
+                    --interface "wg${side^^}" --count "$scale_add" --start "$scale_previous" \
+                    > "$D/peers-$scale_count-$side.json"
+            fi
+        done
+    fi
+    # sleep: let existing 5-second idle release periods settle before measuring recovered RSS.
+    sleep 12
+    measure "idle-$scale_count" "$H" proc-idle --pids "$WATCH" --seconds 5
+    measure "mem-idle-$scale_count" "$H" proc-mem --pids "$WATCH"
+    snapshot_processes "idle-$scale_count"
+    profile "scale-$scale_count" 1800 1000 10
+    # sleep: measure retained RSS after both idle-release periods have elapsed.
+    sleep 12
+    measure "mem-recovered-$scale_count" "$H" proc-mem --pids "$WATCH"
+    snapshot_processes "recovered-$scale_count"
+    scale_previous=$scale_count
+done
+note j324-scale '{"peers":[1,100,1000],"active_peers":1,"flows":8,"additional_peers":"configured, unhandshaken, no endpoint or keepalive","measurement":"diagnostic; performance acceptance requires separate D348 calibration"}'
+exit 0
